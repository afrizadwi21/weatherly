# ==============================================================================
# WEATHERLY PLATFORM — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# --- Application General ---
APP_NAME=weatherly-platform
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=debug

# --- PostgreSQL 16 + PostGIS 3.4 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=weatherly
POSTGRES_PASSWORD=weatherly_secret_password
POSTGRES_DB=weatherly_db
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://weatherly:weatherly_secret_password@localhost:5432/weatherly_db?sslmode=disable

# --- Redis 7 (Weather Cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=replace-with-32-byte-minimum-cryptographic-secret-key
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_HOURS=168

# --- Default Initial Region (Kota Bandung, Jawa Barat — BMKG 32.73) ---
DEFAULT_REGION_NAME=Bandung
DEFAULT_LATITUDE=-6.9175
DEFAULT_LONGITUDE=107.6191
DEFAULT_BMKG_ADM2_CODE=32.73

# --- External Weather Providers (BMKG Jawa Barat 32 & Open-Meteo) ---
BMKG_JABAR_URL=https://www.bmkg.go.id/cuaca/prakiraan-cuaca/32
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1

# --- AI Weather Insights (Google Gemini 2.5 Flash) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
